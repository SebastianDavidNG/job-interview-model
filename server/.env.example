# Groq (recomendado para respuestas en tiempo real; tier gratuito generoso)
# Obtener clave: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Puerto del servidor (por defecto 3001)
PORT=3001

# Orígenes permitidos para CORS (en producción poner la URL de tu frontend)
# Varios orígenes separados por coma: https://tu-app.vercel.app,https://www.tudominio.com
CORS_ORIGIN=http://localhost:3000
